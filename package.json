{
  "name": "saras-enterprise-website",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "description": "Production-ready promotional website for the SARAS Interactive Safety Platform.",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 6066 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 6066 --strictPort",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "clean": "node ./scripts/clean.mjs",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run build",
    "start": "vite --host 127.0.0.1 --port 6066 --strictPort"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@hookform/resolvers": "5.4.0",
    "clsx": "2.1.1",
    "framer-motion": "12.42.2",
    "lucide-react": "1.26.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-helmet-async": "3.0.0",
    "react-hook-form": "7.82.0",
    "react-router-dom": "7.18.1",
    "swiper": "14.0.6",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.15.30",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5"
  }
}
